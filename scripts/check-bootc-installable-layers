#!/usr/bin/env bash
# check-bootc-installable-layers — every small layer of a published image
# must be a tar stream bootc can import.
#
# A LABEL-only (or otherwise content-free) build stage emits an empty tar
# layer, and bootc's layer splitter rejects it with "Truncated tar archive"
# (tuna-os/tunaOS#3378) — while `podman pull` and `podman run` stay green,
# so nothing else catches it. This gate fetches the pushed manifest, pulls
# every layer under 4 KiB, and requires each to list at least one tar entry.
#
# Usage:
#   scripts/check-bootc-installable-layers [--arch amd64] <ref>
#
# <ref> is registry/repo:tag or registry/repo@digest (anonymous read).
# Needs: curl, jq, tar, and zstd for zstd layers. Docker Hub, GHCR, Quay,
# unauthenticated registries, and local HTTP test registries are supported.
set -euo pipefail

ARCH="amd64"
if [[ "${1:-}" == "--arch" ]]; then
  ARCH="${2:?--arch needs a value (e.g. amd64, arm64)}"
  shift 2
fi
REF="${1:?usage: check-bootc-installable-layers [--arch ARCH] <registry/repo:tag|registry/repo@digest>}"

FIRST="${REF%%/*}"
if [[ "$REF" == */* ]] &&
  [[ "$FIRST" == *.* || "$FIRST" == *:* || "$FIRST" == localhost ]]; then
  REGISTRY="$FIRST"
  REST="${REF#*/}"
else
  REGISTRY="docker.io"
  REST="$REF"
fi
if [[ "$REGISTRY" == docker.io && "$REST" != */* ]]; then
  REST="library/${REST}"
fi
REPO="${REST%%[:@]*}"

api_host() {
  case "$1" in
    docker.io) printf 'registry-1.docker.io' ;;
    *) printf '%s' "$1" ;;
  esac
}

auth_header() {
  local registry="$1" repo="$2" url="" token_value=""
  case "$registry" in
    docker.io) url="https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repo}:pull" ;;
    quay.io) url="https://quay.io/v2/auth?service=quay.io&scope=repository:${repo}:pull" ;;
    ghcr.io) url="https://ghcr.io/token?scope=repository:${repo}:pull" ;;
    *) return 0 ;;
  esac
  token_value="$(curl -fsS --max-time 20 "$url" 2>/dev/null |
    jq -r '.token // .access_token // empty')"
  [[ -n "$token_value" ]] || return 1
  printf 'Authorization: Bearer %s' "$token_value"
}

API_REGISTRY="$(api_host "$REGISTRY")"

manifest() {
  local ref="$1" accept="$2"
  curl -fsSL "${AUTH[@]}" -H "Accept: ${accept}" \
    "${SCHEME}://${API_REGISTRY}/v2/${REPO}/manifests/${ref}"
}

SCHEME="https"
AUTH=()
if [[ "$REGISTRY" == localhost* || "$REGISTRY" == "127."* || "$REGISTRY" == "[::1]"* ]]; then
  # Local test registries serve plain HTTP with no auth.
  SCHEME="http"
  API_REGISTRY="$REGISTRY"
else
  HEADER="$(auth_header "$REGISTRY" "$REPO")" || {
    echo "check-bootc-installable-layers: cannot get anonymous pull token for ${REGISTRY}/${REPO}" >&2
    exit 1
  }
  [[ -z "$HEADER" ]] || AUTH=(-H "$HEADER")
fi

if [[ "$REST" == *[@:]* ]]; then
  TAG="${REST#*[@:]}"
else
  TAG="latest"
fi
MANIFEST="$(manifest "$TAG" 'application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.oci.image.manifest.v1+json')"
MTYPE="$(echo "$MANIFEST" | jq -r '.mediaType')"
if [[ "$MTYPE" == *"manifest.list"* || "$MTYPE" == *"image.index"* ]]; then
  DIGEST="$(echo "$MANIFEST" | jq -r ".manifests[] | select(.platform.architecture==\"${ARCH}\") | .digest" | head -n 1)"
  [[ -n "$DIGEST" && "$DIGEST" != "null" ]] || { echo "check-bootc-installable-layers: no ${ARCH} manifest in ${REF}" >&2; exit 1; }
  MANIFEST="$(manifest "$DIGEST" 'application/vnd.oci.image.manifest.v1+json')"
fi
mapfile -t LAYERS < <(echo "$MANIFEST" | jq -r '.layers[] | "\(.digest) \(.size) \(.mediaType)"')
[[ "${#LAYERS[@]}" -gt 0 ]] || { echo "check-bootc-installable-layers: no layers in ${REF}" >&2; exit 1; }

fail=0
idx=0
for entry in "${LAYERS[@]}"; do
  digest="${entry%% *}"; rest="${entry#* }"
  size="${rest%% *}"; media="${rest#* }"
  idx=$((idx + 1))
  if [[ "$size" -ge 4096 ]]; then
    continue
  fi
  blob="$(mktemp)"
  if ! curl -fsSL "${AUTH[@]}" \
      "${SCHEME}://${API_REGISTRY}/v2/${REPO}/blobs/${digest}" -o "$blob"; then
    echo "check-bootc-installable-layers: cannot fetch layer ${idx} ${digest}" >&2
    rm -f "$blob"; fail=1; continue
  fi
  entries=""
  case "$media" in
    *gzip*) entries="$(gzip -dc "$blob" 2>/dev/null | { tar -t 2>/dev/null; status=$?; cat >/dev/null; exit "$status"; } | awk 'NR <= 2')" ;;
    *zstd*) entries="$(zstd -dc "$blob" 2>/dev/null | { tar -t 2>/dev/null; status=$?; cat >/dev/null; exit "$status"; } | awk 'NR <= 2')" ;;
    *tar)   entries="$(tar -t -f "$blob" 2>/dev/null | awk 'NR <= 2')" ;;
    *) echo "check-bootc-installable-layers: layer ${idx} ${digest} has unknown media type ${media}" >&2; rm -f "$blob"; fail=1; continue ;;
  esac
  rm -f "$blob"
  if [[ -z "$entries" ]]; then
    echo "check-bootc-installable-layers: layer ${idx} ${digest} (${size} bytes, ${media}) holds no tar entries — bootc install rejects it (tuna-os/tunaOS#3378)" >&2
    fail=1
  fi
done

if [[ "$fail" == "1" ]]; then
  exit 1
fi
echo "check-bootc-installable-layers: ${#LAYERS[@]} layers, all small layers importable — ${REF}"
