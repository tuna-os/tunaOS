# ujust completion for bash: delegate to just's dynamic (clap) completer,
# pointed at ujust's justfile.
#
# The common payload ships `source <(JUST_COMPLETE=bash ujust)`, which emits
# a completer registered for `just` instead of `ujust` and completes against
# the current directory's justfile rather than ujust's — so `ujust <tab>`
# surfaces nothing useful. This file replaces it; install-tunaos-overrides.sh
# re-installs it after the common payload (every Containerfile copies the
# common layers last).
_ujust() {
    local IFS=$'\013'
    local _CLAP_COMPLETE_COMP_TYPE=${COMP_TYPE}
    local _CLAP_COMPLETE_SPACE=true
    if compopt +o nospace 2>/dev/null; then
        _CLAP_COMPLETE_SPACE=false
    fi
    local justfile=/usr/share/ublue-os/just/00-entry.just
    local words=("just")
    local _CLAP_COMPLETE_INDEX=$COMP_CWORD
    if [[ -r $justfile ]]; then
        words+=("--justfile" "$justfile")
        _CLAP_COMPLETE_INDEX=$((COMP_CWORD + 2))
    fi
    local i
    for ((i = 1; i < ${#COMP_WORDS[@]}; i++)); do
        if ((i == COMP_CWORD)); then
            words+=("$2")
        else
            words+=("${COMP_WORDS[i]}")
        fi
    done
    if ((COMP_CWORD >= ${#COMP_WORDS[@]})); then
        words+=("$2")
    fi
    COMPREPLY=( $( \
        _CLAP_IFS="$IFS" \
        _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
        _CLAP_COMPLETE_COMP_TYPE="$_CLAP_COMPLETE_COMP_TYPE" \
        _CLAP_COMPLETE_SPACE="$_CLAP_COMPLETE_SPACE" \
        JUST_COMPLETE="bash" \
        "just" -- "${words[@]}" \
    ) )
    if [[ $? != 0 ]]; then
        unset COMPREPLY
    elif [[ $_CLAP_COMPLETE_SPACE == false ]] && [[ "${COMPREPLY-}" =~ [=/:]$ ]]; then
        compopt -o nospace
    fi
}
if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -o nospace -o bashdefault -o nosort -F _ujust ujust
else
    complete -o nospace -o bashdefault -F _ujust ujust
fi
