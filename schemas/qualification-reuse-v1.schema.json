{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunaos.org/schemas/qualification-reuse-v1.schema.json",
  "title": "Immutable qualification image reuse v1",
  "$comment": "A producer receipt permits byte reuse only after exact source, config, build-input, image and platform comparison. Harness and tool changes invalidate named verdicts.",
  "oneOf": [
    { "$ref": "#/$defs/producerReceipt" },
    { "$ref": "#/$defs/currentInputs" },
    { "$ref": "#/$defs/reuseDecision" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "assertionNames": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "configDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["manifestDigest", "configDigest"]
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "$ref": "#/$defs/token" },
        "variant": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]{0,79}$" }
      },
      "required": ["os", "architecture", "variant"]
    },
    "affectedInput": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "assertions": { "$ref": "#/$defs/assertionNames" }
      },
      "required": ["digest", "assertions"]
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sourceReceipt": { "$ref": "#/$defs/digest" },
        "configReceipt": { "$ref": "#/$defs/digest" },
        "build": {
          "type": "object", "minProperties": 1, "maxProperties": 512,
          "propertyNames": { "$ref": "#/$defs/token" },
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "harness": {
          "type": "object", "maxProperties": 512,
          "propertyNames": { "$ref": "#/$defs/token" },
          "additionalProperties": { "$ref": "#/$defs/affectedInput" }
        }
      },
      "required": ["sourceReceipt", "configReceipt", "build", "harness"]
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]{0,79}$" },
        "assertions": { "$ref": "#/$defs/assertionNames" }
      },
      "required": ["version", "assertions"]
    },
    "tools": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/token" },
      "additionalProperties": { "$ref": "#/$defs/tool" }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "runUrl": { "type": "string", "format": "uri", "maxLength": 512 },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "$ref": "#/$defs/token" },
        "artifactUrl": { "type": "string", "format": "uri", "maxLength": 512 },
        "artifactSha256": { "$ref": "#/$defs/digest" },
        "headSha": { "$ref": "#/$defs/commit" }
      },
      "required": ["repository", "workflowPath", "runId", "runAttempt", "runUrl", "artifactId", "artifactName", "artifactUrl", "artifactSha256", "headSha"]
    },
    "assertions": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/token" },
      "additionalProperties": { "enum": ["passed", "failed", "skipped", "not-run"] }
    },
    "base": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "image": { "$ref": "#/$defs/image" },
        "inputs": { "$ref": "#/$defs/inputs" },
        "platform": { "$ref": "#/$defs/platform" },
        "tools": { "$ref": "#/$defs/tools" }
      },
      "required": ["schemaVersion", "image", "inputs", "platform", "tools"]
    },
    "producerReceipt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "schemaVersion": { "const": 1 },
            "image": { "$ref": "#/$defs/image" },
            "inputs": { "$ref": "#/$defs/inputs" },
            "platform": { "$ref": "#/$defs/platform" },
            "tools": { "$ref": "#/$defs/tools" },
            "producer": { "$ref": "#/$defs/producer" },
            "assertions": { "$ref": "#/$defs/assertions" }
          },
          "required": ["schemaVersion", "image", "inputs", "platform", "tools", "producer", "assertions"]
        }
      ]
    },
    "currentInputs": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "schemaVersion": { "const": 1 },
            "image": { "$ref": "#/$defs/image" },
            "inputs": { "$ref": "#/$defs/inputs" },
            "platform": { "$ref": "#/$defs/platform" },
            "tools": { "$ref": "#/$defs/tools" }
          },
          "required": ["schemaVersion", "image", "inputs", "platform", "tools"]
        }
      ]
    },
    "reuseDecision": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "reusable": { "const": true },
        "image": { "$ref": "#/$defs/image" },
        "sourceReceipt": { "$ref": "#/$defs/digest" },
        "configReceipt": { "$ref": "#/$defs/digest" },
        "producer": { "$ref": "#/$defs/producer" },
        "platform": { "$ref": "#/$defs/platform" },
        "producerTools": { "$ref": "#/$defs/tools" },
        "currentTools": { "$ref": "#/$defs/tools" },
        "changedHarnessInputs": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "changedTools": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "invalidatedAssertions": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "assertions": { "$ref": "#/$defs/assertions" }
      },
      "required": ["schemaVersion", "reusable", "image", "sourceReceipt", "configReceipt", "producer", "platform", "producerTools", "currentTools", "changedHarnessInputs", "changedTools", "invalidatedAssertions", "assertions"]
    }
  }
}
