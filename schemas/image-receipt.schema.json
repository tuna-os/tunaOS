{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tunaos.org/image-receipt.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "image-receipt",
      "type": "string"
    },
    "target": {
      "$ref": "identity.schema.json#/$defs/target"
    },
    "contractDigest": {
      "$ref": "identity.schema.json#/$defs/digest"
    },
    "baseDigest": {
      "$ref": "identity.schema.json#/$defs/digest"
    },
    "attemptIdentity": {
      "$ref": "identity.schema.json#/$defs/attemptIdentity"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "identity.schema.json#/$defs/check"
      },
      "minItems": 1
    },
    "imageDigest": {
      "$ref": "identity.schema.json#/$defs/digest"
    },
    "publication": {
      "$ref": "identity.schema.json#/$defs/publication"
    },
    "provenance": {
      "$ref": "identity.schema.json#/$defs/provenance"
    },
    "factoryReceiptDigests": {
      "type": "array",
      "items": {
        "$ref": "identity.schema.json#/$defs/digest"
      },
      "uniqueItems": true
    },
    "sourceRevision": {
      "$ref": "identity.schema.json#/$defs/revision"
    },
    "installedPackages": {
      "type": "array",
      "items": {
        "$ref": "identity.schema.json#/$defs/package"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "target",
    "contractDigest",
    "baseDigest",
    "attemptIdentity",
    "checks",
    "imageDigest",
    "publication",
    "provenance",
    "factoryReceiptDigests",
    "sourceRevision",
    "installedPackages"
  ],
  "additionalProperties": false
}
