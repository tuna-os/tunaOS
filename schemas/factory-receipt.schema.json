{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tunaos.org/factory-receipt.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "schemaVersion",
    "target",
    "factoryDigest",
    "promotionStatus",
    "attemptIdentity",
    "publication",
    "checks",
    "provenance",
    "contractDigest",
    "baseDigest"
  ],
  "properties": {
    "kind": { "const": "factory-receipt" },
    "schemaVersion": { "const": 1 },
    "target": { "$ref": "identity.schema.json#/$defs/target" },
    "factoryDigest": { "$ref": "identity.schema.json#/$defs/digest" },
    "baseDigest": { "$ref": "identity.schema.json#/$defs/digest" },
    "promotionStatus": {
      "enum": ["promoted", "failed", "pending", "blocked", "rejected"]
    },
    "attemptIdentity": { "$ref": "identity.schema.json#/$defs/attemptIdentity" },
    "publication": { "$ref": "identity.schema.json#/$defs/publication" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "identity.schema.json#/$defs/check" }
    },
    "provenance": { "$ref": "identity.schema.json#/$defs/provenance" },
    "contractDigest": { "$ref": "identity.schema.json#/$defs/digest" }
  }
}
