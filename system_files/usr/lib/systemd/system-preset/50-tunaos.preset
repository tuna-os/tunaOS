# TunaOS systemd presets.
#
# ── Why the enables below are not redundant ──────────────────────────────────
#
# The build enables these with `systemctl enable`, which writes a symlink under
# /etc/systemd/system/<target>.wants/. On FIRST BOOT systemd applies preset
# policy, and Fedora's catch-all preset is `disable *`. Any unit not named by a
# preset file therefore has its enablement symlink DELETED on the first boot of
# every image we ship — after the build, so nothing in CI sees it.
#
# Measured on the boot gate of run 32925587829 (hummingbird:gnome):
#
#   [ 7.686065] systemd[1]: Applying preset policy.
#   [ 7.984703] Removed '/etc/systemd/system/multi-user.target.wants/ublue-system-setup.service'
#   [ 7.987145] Removed '/etc/systemd/system/multi-user.target.wants/tunaos-live-ready.service'
#   [ 7.989555] Removed '/etc/systemd/system/multi-user.target.wants/tunaos-base-contract.service'
#   [ 7.992042] Removed '/etc/systemd/system/multi-user.target.wants/flatpak-preinstall.service'
#   [ 7.994497] Removed '/etc/systemd/system/multi-user.target.wants/tailscaled.service'
#   [ 7.998517] Removed '/etc/systemd/system/graphical.target.wants/tunaos-var-home-restorecon.service'
#   [ 8.001120] Removed '/etc/systemd/system/graphical.target.wants/tunaos-desktop-contract.service'
#
# In the same policy pass systemd CREATED symlinks for brew-update.timer and
# flatpak-appstream-refresh.service, which are named by presets — so the
# mechanism works and our own units simply were not in it.
#
# The consequence is not cosmetic. tunaos-desktop-contract.service and
# tunaos-base-contract.service exist only to print the marker the boot gate
# greps for, so with them disabled `scripts/iso-e2e.sh` waited the full 900s
# and exited 2 ("readiness marker not seen"). Gate is a `needs:` of Promote, so
# the image never promotes — on an image that had booted perfectly well to a
# login prompt. tunaos-live-ready.service is the same marker for the ISO path,
# so the ISO axis would have hit this too the moment it got that far.
#
# A preset only affects units that are actually installed, and every unit below
# is enabled unconditionally by the build wherever it is present
# (40-services.sh:522/536/585/611/612, install-desktop.sh:958,
# flatpak-preinstall.sh:71), so naming them here states exactly what the build
# already intends rather than adding new behaviour.
#
# Still unfixed and NOT solvable here: the same pass removed
# /etc/systemd/system/default.target. Presets cannot set the default target.

# Boot contracts — these print the markers the boot gate and iso-e2e grep for.
enable tunaos-base-contract.service
enable tunaos-desktop-contract.service
enable tunaos-live-ready.service

# First-boot setup.
enable tunaos-var-home-restorecon.service
enable ublue-system-setup.service
enable flatpak-preinstall.service
enable tailscaled.service

# ── Suppressions ─────────────────────────────────────────────────────────────
#
# tracker-extract-3.service: installed by tracker3 package but not
# needed in our build environments. Without this preset, systemd emits
# a warning on every bootc deployment.

disable tracker-extract-3.service
