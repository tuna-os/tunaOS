#!/usr/bin/python3
"""Weekly categorical adoption reports. Persistent state never leaves the host."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import tempfile
import time
import urllib.request
from dataclasses import dataclass

WEEK = 604800
ENDPOINT = "https://countme.tunaos.org/v1/report"
FIELDS = {"schema", "variant", "flavor"}
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")


@dataclass(frozen=True)
class Paths:
    root: Path = Path("/")

    def path(self, name: str) -> Path:
        return self.root / name.lstrip("/")

    @property
    def state(self) -> Path:
        return self.path("/var/lib/tunaos-countme")

    @property
    def control(self) -> Path:
        return self.path("/etc/tunaos/countme")

    @property
    def metadata(self) -> Path:
        return self.path("/usr/share/tunaos/countme.json")


def utc_week(now: int) -> int:
    return (now + 259200) // WEEK


def age_bucket(epoch: int, now: int) -> int:
    age = now - epoch
    if age < 0:
        raise ValueError("clock precedes epoch")
    return 1 if age < WEEK else 2 if age < 4 * WEEK else 3 if age < 24 * WEEK else 4


def container_runtime() -> bool:
    try:
        return subprocess.run(
            ["systemd-detect-virt", "--container", "--quiet"],
            timeout=3, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode != 1
    except (OSError, subprocess.TimeoutExpired):
        return True


def clock_synchronized(paths: Paths) -> bool:
    if paths.path("/run/systemd/timesync/synchronized").exists():
        return True
    try:
        return subprocess.run(
            ["timedatectl", "show", "--property=NTPSynchronized", "--value"],
            timeout=3, check=False, capture_output=True, text=True,
        ).stdout.strip() == "yes"
    except (OSError, subprocess.TimeoutExpired):
        return False


def enabled(paths: Paths) -> bool:
    # An /etc marker survives image upgrades and overrides the vendor timer.
    return not (paths.control / "disabled").exists()


def eligible(paths: Paths) -> bool:
    if not enabled(paths) or not paths.path("/run/ostree-booted").exists():
        return False
    if any(paths.path(p).exists() for p in (
        "/run/tunaos-live", "/etc/tunaos/live-session", "/run/tunaos-countme-disabled",
        "/run/initramfs/live", "/run/live/medium",
    )):
        return False
    try:
        product = paths.path("/sys/class/dmi/id/product_name").read_text().strip()
    except OSError:
        product = ""
    if product == "tunaos-countme-disabled":
        return False
    try:
        cmdline = paths.path("/proc/cmdline").read_text().split()
    except OSError:
        return False
    if any(token in {"rd.live.image", "rd.live.image=1", "boot=live",
                     "tunaos.countme=0", "tunaos.countme=off"} for token in cmdline):
        return False
    return not container_runtime() and clock_synchronized(paths)


def metadata(paths: Paths) -> dict:
    value = json.loads(paths.metadata.read_text())
    if not isinstance(value, dict) or set(value) != FIELDS or type(value["schema"]) is not int or value["schema"] != 1:
        raise ValueError("invalid metadata")
    for key in ("variant", "flavor"):
        if not isinstance(value[key], str) or len(value[key]) > 64 or not SLUG.fullmatch(value[key]):
            raise ValueError("invalid category")
    return value


def durable_write(path: Path, value: dict) -> None:
    """Commit the file AND directory before any HTTP operation."""
    fd, temporary = tempfile.mkstemp(prefix=".countme-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle, separators=(",", ":"))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def send(payload: dict) -> bool:
    request = urllib.request.Request(
        ENDPOINT, data=json.dumps(payload, separators=(",", ":")).encode(),
        headers={"Content-Type": "application/json", "User-Agent": "tunaos-countme/1"},
        method="POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(request, timeout=15) as response:
        return response.status == 204


def run(paths: Paths = Paths(), now: int | None = None, sender=None) -> str:
    if not eligible(paths):
        return "ineligible"
    now = int(time.time()) if now is None else now
    if type(now) is not int or now < 1704067200:
        return "invalid-clock"
    try:
        image = metadata(paths)
        arch = platform.machine()
        if arch not in {"x86_64", "aarch64", "ppc64le", "s390x", "riscv64"}:
            return "unknown-architecture"
        categories = json.loads(paths.path("/usr/share/tunaos/countme-allowlist.json").read_text())
        if not isinstance(categories, list) or not any(
            cell == {"variant": image["variant"], "flavor": image["flavor"], "arch": arch}
            for cell in categories
        ):
            return "unknown-image"
        paths.state.mkdir(mode=0o700, parents=True, exist_ok=True)
        with (paths.state / "lock").open("a+b") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if not enabled(paths):
                return "disabled"
            state_file = paths.state / "state.json"
            state = json.loads(state_file.read_text()) if state_file.exists() else {
                "epoch": now, "last_week": None,
            }
            week = utc_week(now)
            if (not isinstance(state, dict) or set(state) != {"epoch", "last_week"}
                or type(state["epoch"]) is not int or not 1704067200 <= state["epoch"] <= now
                or (state["last_week"] is not None and
                    (type(state["last_week"]) is not int or not 0 <= state["last_week"] <= week))):
                return "invalid-state"
            if state["last_week"] == week:
                return "already-attempted"
            payload = {**image, "arch": arch, "age_bucket": age_bucket(state["epoch"], now)}
            durable_write(state_file, {**state, "last_week": week})
            try:
                return "reported" if (sender or send)(payload) else "request-failed"
            except (OSError, ValueError):
                return "request-failed"
    except (OSError, ValueError, TypeError):
        return "invalid-state-or-metadata"


def control(action: str, paths: Paths = Paths()) -> None:
    if os.geteuid() != 0:
        raise PermissionError("run this command with sudo")
    paths.control.mkdir(mode=0o755, parents=True, exist_ok=True)
    if action == "disable":
        durable_write(paths.control / "disabled", {"disabled": True})
        (paths.control / "enabled").unlink(missing_ok=True)
        subprocess.run(["systemctl", "mask", "--now", "tunaos-countme.timer",
                        "tunaos-countme.service"], check=True)
    else:
        print("Send weekly variant, flavor, architecture and broad age reports.")
        print("No device ID is sent. Cloudflare processes source IPs for transport.")
        print("Public estimates: https://tunaos.org/metrics")
        (paths.control / "disabled").unlink(missing_ok=True)
        (paths.control / "enabled").touch(mode=0o644)
        subprocess.run(["systemctl", "unmask", "tunaos-countme.timer",
                        "tunaos-countme.service"], check=True)
        subprocess.run(["systemctl", "enable", "--now", "tunaos-countme.timer"], check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("report", "enable", "disable", "status"))
    action = parser.parse_args().action
    try:
        if action == "status":
            print("enabled" if enabled(Paths()) else "disabled (persistent opt-out)")
        elif action in {"enable", "disable"}:
            control(action)
        else:
            print(run())
        return 0
    except (OSError, subprocess.SubprocessError):
        print("Countme control failed. Check permissions and systemd unit state.")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
