{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable builder flavor semantics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "flavors"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "builder-flavor-metadata"
    },
    "flavors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "desktop",
          "edition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])"
          },
          "desktop": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])"
          },
          "edition": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])"
          }
        }
      }
    }
  }
}
