                                  "type": "string",
                                  "pattern": "^https://[^\\s/@\\\\:]+(?::443)?(?:[/?#][^\\s\\\\]*)?$"
                                },
                                {
                                  "type": "string",
                                  "pattern": "^/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                                }
                              ]
                            },
