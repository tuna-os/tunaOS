{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISO Builder presentation configuration v1",
  "description": "Presentation only. Portable validators must also enforce unique ids and referential integrity; this schema cannot grant target admission or transport permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_only",
    "brand",
    "presentation",
    "output",
    "desktops",
    "variants",
    "default_selection",
    "curated_app_sets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "preview_only": {
      "type": "boolean"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "homepage_url",
        "documentation_url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "homepage_url": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
        },
        "documentation_url": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
        },
        "logo_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
            },
            {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?![\\s\\S])"
            }
          ]
        },
        "favicon_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
            },
            {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?![\\s\\S])"
            }
          ]
        },
        "support_url": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "intro",
        "accent_color"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])#[0-9a-fA-F]{6}(?![\\s\\S])"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_label",
        "filename_prefix"
      ],
      "properties": {
        "volume_label": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[A-Z0-9_]{1,32}(?![\\s\\S])"
        },
        "filename_prefix": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
        }
      }
    },
    "desktops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "default_flatpaks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          },
          "default_flatpaks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*\\.){2,}[A-Za-z_-][A-Za-z0-9_-]*(?![\\s\\S])",
              "maxLength": 255
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          }
        }
      }
    },
    "default_selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "variant",
            "flavor",
            "platform"
          ],
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "variant": {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
            },
            "flavor": {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
            },
            "platform": {
              "enum": [
                "linux/amd64",
                "linux/amd64/v2",
                "linux/amd64/v3",
                "linux/arm64"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image",
            "platform"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "image": {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]+)?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(?:@sha256:[0-9a-f]{64})?|@sha256:[0-9a-f]{64})(?![\\s\\S])"
            },
            "platform": {
              "enum": [
                "linux/amd64",
                "linux/amd64/v2",
                "linux/amd64/v3",
                "linux/arm64"
              ]
            }
          }
        }
      ]
    },
    "curated_app_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "desktops",
          "url",
          "format"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          },
          "desktops": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
            }
          },
          "url": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\])https://(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?=[^/?#:]{1,253}(?::443)?(?:[/?#]|$))(?!(?:[^./?#:]+\\.)*(?:[0-9]+|0[xX][0-9A-Fa-f]*)\\.?(?::443)?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?)(?::443)?(?:[/?#][^\\x00-\\x20\\x7f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\\\]*)?(?![\\s\\S])"
          },
          "format": {
            "enum": [
              "brewfile",
              "preinstall"
            ]
          }
        }
      }
    },
    "ddi_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stem",
          "name",
          "desktop"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          },
          "stem": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          },
          "desktop": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "preview_only": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "brand": {
            "required": [
              "disclaimer"
            ]
          }
        }
      }
    }
  ]
}
