                "leaf_id"
              ],
              "properties": {
                "kind": {
                  "const": "leaf"
                },
                "leaf_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9:/._-]{0,191}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none"
                }
              }
            }
          ]
        },
        "curated_app_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
