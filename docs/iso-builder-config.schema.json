                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9/.-]{0,63}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^<>\\u0000-\\u001f\\u007f]*\\S[^<>\\u0000-\\u001f\\u007f]*$",
                          "maxLength": 2048
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^<>\\u0000-\\u001f\\u007f]*\\S[^<>\\u0000-\\u001f\\u007f]*$",
