# Containerfile.debian — Debian bootcification.
#
# Builds a bootc-compatible Debian image from stock debian:trixie or
# debian:sid. Based on bootcrew/mono/debian pattern.
#
# Usage:
#   buildah build --build-arg BASE_IMAGE=docker.io/library/debian:trixie \
#     --target=kde --file Containerfile.debian .

ARG BASE_IMAGE="docker.io/library/debian:trixie@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1"
ARG COMMON_IMAGE_REF="ghcr.io/projectbluefin/common:unpinned-must-override"

ARG DESKTOP_FLAVOR="${DESKTOP_FLAVOR:-gnome}"
ARG IMAGE_NAME
ARG IMAGE_VENDOR
ARG SHA_HEAD_SHORT
ARG ENABLE_SSHD="${ENABLE_SSHD:-0}"
ARG IMAGE_REGISTRY="ghcr.io"
ARG IMAGE_NAME_VARIANT

# ── Fetch the prebuilt bootc toolchain ────────────────────────────────────────
# bootc + bootupd (+ libostree/composefs on trixie) are built from source by
# .github/workflows/build-toolchain.yml and published to
# ghcr.io/tuna-os/bootc-toolchain-<base> as a public OCI artifact (oras). Pull it
# here instead of recompiling bootc on every variant build. See
# toolchain/Containerfile.debian and image-versions.yaml (Renovate-pinned).
FROM ${BASE_IMAGE} AS bootc-builder
ARG BASE_IMAGE
ARG ORAS_VERSION=1.2.0
ARG TARGETARCH
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends curl ca-certificates tar gzip && \
    curl -fsSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin oras && \
    case "${BASE_IMAGE}" in *sid*) TC=sid ;; *) TC=trixie ;; esac && \
    mkdir -p /fetch /output && cd /fetch && \
    oras pull "ghcr.io/tuna-os/bootc-toolchain-${TC}:latest-${TARGETARCH}" && \
    tar -xzf toolchain.tar.gz -C /output && \
    rm -rf /fetch

# ── Context layer ────────────────────────────────────────────────────────────
FROM scratch AS context
COPY system_files /files
COPY system_files_overrides /overrides
COPY build_scripts /build_scripts
COPY manifests /manifests
COPY image-versions.yaml /image-versions.yaml

FROM ${COMMON_IMAGE_REF} AS common

# ── Base system (bootc-compatible Debian) ────────────────────────────────────
FROM ${BASE_IMAGE} AS base-no-de

ARG BASE_IMAGE
ARG IMAGE_NAME
ARG IMAGE_VENDOR
ARG IMAGE_NAME_VARIANT
ARG SHA_HEAD_SHORT
ARG ENABLE_SSHD
ARG DESKTOP_FLAVOR
ARG IMAGE_REGISTRY

ENV BASE_IMAGE=${BASE_IMAGE}
ENV IMAGE_NAME=${IMAGE_NAME}
ENV IMAGE_VENDOR=${IMAGE_VENDOR}
ENV IMAGE_NAME_VARIANT=${IMAGE_NAME_VARIANT}
ENV IMAGE_REGISTRY=${IMAGE_REGISTRY}
ENV ENABLE_SSHD=${ENABLE_SSHD}
ENV DESKTOP_FLAVOR=${DESKTOP_FLAVOR}

# Install the bootc toolchain (bootc + bootupd [+ source libostree/composefs on
# trixie]) from the fetch stage.
COPY --from=bootc-builder /output /

# libostree: sid ships one new enough (>=2025.3), so install the packaged libs.
# trixie's packaged libostree (2025.2) is too old and would conflict with the
# source libostree already placed by the toolchain COPY above — so instead
# provide an equivs dummy libostree-1-1 (Snow Linux trick) to satisfy apt deps
# (flatpak etc.) without pulling the old lib, and register the source libs.
RUN apt-get update -y && \
    case "${BASE_IMAGE}" in \
      *sid*) DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libostree-1-1 ostree ;; \
      *) DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends equivs && \
         printf 'Package: libostree-1-1\nVersion: 99:0\nArchitecture: %s\nMaintainer: TunaOS <build@tunaos.org>\nDescription: satisfied by source libostree from bootc-toolchain\n' "$(dpkg --print-architecture)" > /tmp/libostree.ctl && \
         ( cd /tmp && equivs-build libostree.ctl && dpkg -i libostree-1-1_*.deb ) && \
         apt-mark hold libostree-1-1 && ldconfig ;; \
    esac

# Install base system packages
#
# systemd-cryptsetup ships /usr/bin/systemd-cryptenroll on trixie and sid — NOT
# the systemd package, verified against the trixie file list. fisherman requires
# it on the installing host and aborts before touching the disk without it:
#
#   fatal: missing required host tool: "systemd-cryptenroll" not found in PATH
#     — install the "systemd" package on the host
#
# That hint is Fedora-shaped and misleading here: systemd is already in the list
# below. This killed flounder:kde in LUKS run 31060069809 after the image, the
# ISO and the live boot had all succeeded.
#
# The package name is release-specific, so do NOT copy it elsewhere without
# checking: Ubuntu noble ships the binary in systemd and has no
# systemd-cryptsetup at all, and assuming otherwise broke gurnard (run
# 31061160416). This Containerfile only ever builds trixie and sid, where the
# split package is correct; the assertion after the install is what makes a
# future move fail loudly instead of silently.
RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        btrfs-progs \
        dosfstools \
        e2fsprogs \
        fdisk \
        firmware-linux-free \
        linux-image-generic \
        skopeo \
        podman \
        # The Debian/Ubuntu bootc bases ship no sudo, unlike the Fedora/EL
        # ones. customize-live.sh writes a NOPASSWD sudoers drop-in for
        # liveuser on dev ISOs, which authorises nothing without the binary —
        # every `sudo` in the E2E guest then dies with "command not found"
        # (tunaOS#953 defect 3 on sailfin, again on grouper). The assertion in
        # customize-live.sh now catches its absence at ISO-build time.
        sudo \
        systemd \
        systemd-boot \
        xfsprogs \
        dracut \
        dmsetup \
        squashfs-tools \
        cryptsetup \
        systemd-cryptsetup \
        network-manager \
        pipewire \
        wireplumber \
        flatpak \
        fwupd \
        plymouth \
        power-profiles-daemon \
        curl \
        unzip \
        git \
        ca-certificates \
        # dracut's tpm2-tss module is part of the default module set on this
        # base, and dracut treats a requested-but-unsatisfiable module as fatal
        # rather than skipping it:
        #
        #   dracut[E]: Module 'tpm2-tss' cannot be installed.
        #
        # That is an ISO-build failure, not an image one — tacklebox rebuilds
        # the initramfs against the published image to inject tbox-live and
        # tbox-root, and its omit-detection only drops a module whose
        # modules.d directory is ABSENT. Debian ships the directory and not
        # the userspace, so the module is requested and cannot be installed.
        #
        # flounder:kde is green and flounder:gnome died here (run 31071849261)
        # purely because the Plasma package set happens to pull enough of the
        # tss2 stack in transitively. Naming it makes that an intent rather
        # than an accident.
        #
        # Containerfile.ubuntu already installs exactly this list, with the
        # same reasoning, and Debian never got it. Installing the userspace is
        # the right resolution rather than omitting the module: LUKS
        # auto-unlock is enrolled post-install, so the initramfs has to be able
        # to talk to the TPM when that happens.
        #
        # The t64 suffixes are the 64-bit time_t transition. Verified against
        # the trixie AND sid binary indexes — the unsuffixed names exist in
        # neither.
        tpm2-tools libtss2-tcti-device0t64 libtss2-tctildr0t64 \
        libtss2-rc0t64 libtss2-esys-3.0.2-0t64 && \
    # Assert the binary, not the package. fisherman aborts before touching the
    # disk without it, and which package ships it is not stable across releases
    # (trixie: systemd-cryptsetup; Ubuntu noble: systemd). Failing here names
    # the problem; failing in fisherman surfaces 40 minutes later inside a VM.
    if ! command -v systemd-cryptenroll >/dev/null 2>&1; then \
        echo "ERROR: systemd-cryptenroll missing after install." >&2; \
        echo "       fisherman needs it to enrol the LUKS TPM2 keyslot and aborts without it." >&2; \
        exit 1; \
    fi && \
    apt-get clean -y

RUN --mount=type=bind,from=context,source=/,target=/run/context \
    bash -c "source /run/context/build_scripts/lib.sh && source /run/context/build_scripts/10-base-packages.sh"

RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/20-packages.sh

# remora — the desktop experience contract requires it, and this base does
# not run 26-packages-post.sh, which is what installs remora on the dnf
# variants. Containerfile.opensuse already hit this and calls
# install-remora.sh directly for the same reason (see the comment there).
# Without it every Gate on this base fails with
#
#   TUNAOS_DESKTOP_CONTRACT_FAIL reason=remora_contract_missing
#
# which reads as a broken desktop when the desktop booted fine — grouper gnome,
# kde, xfce and gnome-zfs all died this way in run 30692866756. The binary is
# static Go, so there is nothing distro-specific to guard.
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/install-remora.sh

# Copy kernel to modules directory (Debian puts it in /boot)
RUN cp /boot/vmlinuz-* "$(find /usr/lib/modules -maxdepth 1 -type d | tail -1)/vmlinuz"

# Set up bootc/ostree filesystem layout. The shared layout (the /var wipe, the
# alias symlinks, tmpfiles.d and prepare-root.conf) lives in ostree-layout.sh;
# what stays here is the dpkg relocation, which must bracket it — the copy out
# of /var before the wipe, the tmpfiles link back after it.
#
# NOTE: this MUST precede the dracut step below. dracut-config.sh derives the
# driver set from prepare-root.conf, which ostree-layout.sh writes, so building
# the initramfs first would read no composefs declaration and silently produce
# one with no erofs driver — an image that cannot mount its own root.
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    # Move the dpkg database out of /var BEFORE the wipe below, or the image
    # ships with no record of its own packages.
    #
    # /var/lib/dpkg is where dpkg keeps `status`, and the wipe on the next
    # line takes it. That is not a TunaOS quirk — every Debian/Ubuntu bootc
    # image does this (bootcrew/ubuntu-bootc: `rm -rf ... /var`), and the
    # result is measurable: ghcr.io/tuna-os/flounder:base answers
    # `dpkg-query -W` with zero packages and has no `status` file anywhere.
    # A running flounder box therefore cannot enumerate its own packages,
    # which blinds remora layering, update tooling and support diagnostics
    # (tuna-os/tunaos-packages#135).
    #
    # Fedora hit the identical problem with rpm and solved it by relocating
    # the database into /usr, where it belongs anyway: the package database
    # describes /usr, and keeping it there means it snapshots and rolls back
    # with the image (Changes/RelocateRPMToUsr). Same move here.
    #
    # The tmpfiles symlink below points /var/lib/dpkg back at it, so dpkg,
    # apt and dpkg-query all keep working through their default paths with no
    # --admindir plumbing.
    mkdir -p /usr/lib/sysimage && \
    if [ -d /var/lib/dpkg ]; then cp -a /var/lib/dpkg /usr/lib/sysimage/dpkg; fi && \
    /run/context/build_scripts/bootc/ostree-layout.sh && \
    # apt keeps its own log directory under the wiped /var.
    mkdir -p /var/log/apt && \
    # Restore the dpkg database path at runtime. L+ replaces whatever is
    # there, so a /var reset re-establishes the link rather than leaving apt
    # pointing at an empty directory. /var/lib must be created first —
    # tmpfiles does not build parents for L+.
    printf 'd /var/lib 0755 root root -\nd /var/log/apt 0755 root root -\nL+ /var/lib/dpkg - - - - ../../usr/lib/sysimage/dpkg\n' \
        > /usr/lib/tmpfiles.d/dpkg-sysimage.conf && \
    # Image-build time too: apt/dpkg run in later layers (and in
    # live_customize) before tmpfiles has ever executed.
    mkdir -p /var/lib && ln -sfnT ../../usr/lib/sysimage/dpkg /var/lib/dpkg

# Build initramfs. Live-boot modules are NOT needed here: tacklebox
# injects its own embedded tbox-live/tbox-root dracut modules at ISO
# build time using this image's stock dracut (tuna-os/tacklebox#90).
# dracut config comes from build_scripts/bootc/dracut-config.sh, shared with
# every other bootc variant — it derives the driver set from the image rather
# than from a printf that has to be kept in sync by hand.
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    KVER=$(basename "$(find /usr/lib/modules -maxdepth 1 -mindepth 1 -type d | tail -1)") && \
    /run/context/build_scripts/bootc/dracut-config.sh "${KVER}" && \
    dracut --force "/usr/lib/modules/${KVER}/initramfs.img" "${KVER}"

LABEL containers.bootc 1
COPY --from=context /files /
COPY --from=common /system_files/shared /

# Run the standard numbered base scripts (matching el10/arch/ubuntu convention):
# 40-services (service enablement, dconf), 90-image-info (branding/os-release),
# 99-cleanup (ostree prep). Without these, flounder ships upstream Debian
# identity and fails the branding contract.
RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=tmpfs,dst=/boot \
  --mount=type=bind,from=context,source=/,target=/run/context \
  /run/context/build_scripts/40-services.sh
RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=tmpfs,dst=/boot \
  --mount=type=bind,from=context,source=/,target=/run/context \
  /run/context/build_scripts/90-image-info.sh
RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=tmpfs,dst=/boot \
  --mount=type=bind,from=context,source=/,target=/run/context \
  /run/context/build_scripts/99-cleanup.sh

# Same COPY of projectbluefin/common's shared tree as Containerfile.ubuntu, so
# the same signature-policy exposure: it pins sigstore requirements with
# `keyPaths`, which only skopeo >= 1.14 parses. trixie's skopeo is new enough
# today and noble's is not — that is a version accident, not a property of
# apt, so validate here too rather than waiting for the accident to change.
RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=bind,from=context,source=/,target=/run/context \
  /run/context/build_scripts/bootc/containers-policy.sh

RUN bootc container lint

# Cache-bust so build_scripts edits invalidate the desktop stages' install
# layers (bind-mounted scripts aren't in the cache key). Inherited by children.
ARG BUILD_SCRIPTS_HASH
ENV BUILD_SCRIPTS_HASH=${BUILD_SCRIPTS_HASH}

# ==============================================================================
# Desktop stages — manifest-driven
# ==============================================================================
FROM base-no-de AS base
RUN ln -sf /var/opt /opt 2>/dev/null || true

FROM base-no-de AS gnome
COPY --from=common /system_files/bluefin /
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/desktop/install-desktop.sh gnome
RUN ln -sf /var/opt /opt 2>/dev/null || true

FROM base-no-de AS kde
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/desktop/install-desktop.sh kde
RUN ln -sf /var/opt /opt 2>/dev/null || true

FROM base-no-de AS cosmic
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/desktop/install-desktop.sh cosmic
RUN ln -sf /var/opt /opt 2>/dev/null || true

FROM base-no-de AS niri
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/desktop/install-desktop.sh niri
RUN ln -sf /var/opt /opt 2>/dev/null || true

FROM base-no-de AS xfce
RUN --mount=type=bind,from=context,source=/,target=/run/context \
    /run/context/build_scripts/desktop/install-desktop.sh xfce
RUN ln -sf /var/opt /opt 2>/dev/null || true
