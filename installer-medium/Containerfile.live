# The experimental image-based installer ships a live layer on top of the
# cell's published digest. CI builds it, installs it to a blank disk, and
# publishes the result; the digest CI qualifies is never rebuilt locally.
#
# This Containerfile is the only layer the medium adds to the deployed image.
# Every unit it ships is inert without tunaos.live on the kernel command
# line, and the install post-hook (installer-medium/hooks/) removes the live
# entry from the installed copy.
#
# The payload stage builds what the live session needs on a Fedora builder, so
# the cell base needs no Go or GTK toolchain: fishermand (static Go binary from
# the pinned fisherman commit) and the desktop's installer frontend. It writes
# into /stage, which the last stage copies over /. Every path the payload adds
# is listed under /usr/share/medium-live/payload.d/ for the post hook.
ARG SOURCE_IMAGE
ARG BUILDER_IMAGE=registry.fedoraproject.org/fedora:43@sha256:a19e8544313a675e6529d3242f74f0015beebdd1834d0bf9b132e669f734f2bf

FROM ${BUILDER_IMAGE} AS payload
ARG DESKTOP
ARG FISHERMAN_REPO
ARG FISHERMAN_REF
# TEST ONLY: an OCI layout of the frontend in the build context
# (frontends/<desktop>/oci-local, from the workflow's frontend job). Empty:
# the pinned bundle is fetched as always. Either way the digest is checked.
ARG TUNA_FRONTEND_OCI_DIR=""
# An owner-approved gnome-setup compat set for this cell, or empty
# (build-live-image.sh, frontends/gnome-setup/compat/for-cell). The RUN below
# sees it as an environment variable, and frontends/gnome/build.sh reads it.
ARG GNOME_SETUP_COMPAT=
# skopeo, ostree and flatpak: frontends/<desktop>/frontend-common.sh fetches
# the pinned frontend bundle and installs it into the staging tree. A real
# build stopped at "skopeo: command not found" without them.
RUN dnf -y install --setopt=install_weak_deps=False git golang coreutils skopeo ostree flatpak
COPY daemon/ /src/daemon/
COPY frontends/ /src/frontends/
RUN set -euxo pipefail; \
    test -n "${DESKTOP}" -a -n "${FISHERMAN_REF}"; \
    install -d /stage /work; \
    /src/daemon/build-fishermand.sh "${FISHERMAN_REPO}" "${FISHERMAN_REF}" /stage; \
    /src/frontends/build-frontend.sh "${DESKTOP}" /work; \
    MEDIUM_PAYLOAD=/work TUNA_FRONTEND_OCI_DIR="${TUNA_FRONTEND_OCI_DIR}" \
        /src/frontends/install-frontend.sh "${DESKTOP}" /stage

FROM ${SOURCE_IMAGE}
COPY --from=payload /stage/ /
COPY live/usr/ /usr/
COPY hooks/medium-install-post /usr/libexec/medium-install-post
COPY hooks/medium-install-post@.service /usr/lib/systemd/system/medium-install-post@.service
COPY hooks/initrd-90medium-install /usr/lib/dracut/modules.d/90medium-install/
# gnome-setup must fit the GTK of this image: a build without the compat set
# aborted on GTK 4.14 (gurnard:pantheon run 45931354235), and a compat set on
# GTK 4.16 or newer is due for retirement. The check stops the build in both
# cases and passes an image without gnome-setup.
COPY frontends/gnome-setup/compat/check-target-gtk /tmp/medium-check-target-gtk
RUN bash /tmp/medium-check-target-gtk / && rm -f /tmp/medium-check-target-gtk
# The RUN steps on the cell base use its /bin/sh: dash on the apt bases
# (Ubuntu, Debian), which has no pipefail ("set: Illegal option -o
# pipefail", gurnard:pantheon run 45755496611), and buildah ignores SHELL in
# the OCI format. These steps have no pipe: set -eux is enough.
RUN set -eux; \
    chmod 0755 /usr/libexec/medium-live-setup /usr/libexec/medium-install-post \
        /usr/libexec/medium-fishermand /usr/libexec/fishermand /usr/libexec/medium-live-installer \
        /usr/libexec/medium-live-gdm-session /usr/libexec/medium-live-session-focus; \
    systemctl enable medium-live-setup.service medium-live-session-focus.service medium-e2e-ssh.service \
        fishermand-sysinstall.socket fishermand-cryptenroll.socket \
        fishermand-shutdown.socket fishermand-fisherman.socket; \
    test -f /etc/xdg/autostart/org.tunaos.installer-live.desktop; \
    test -s /usr/share/medium-live/payload.d/fishermand.list; \
    grep -rq 'ConditionKernelCommandLine=!tunaos.live' /usr/lib/systemd/system/*.d/ && \
    grep -rq 'ConditionKernelCommandLine=!tunaos.live' /usr/lib/systemd/user/*.d/
# /var/run is the link to /run on a booted system. The albacore:gnome image has
# a directory there (a package made /var/run/spice-vdagentd while the link did
# not exist), and tmpfiles leaves a directory alone. A D-Bus client that uses
# the default address, /var/run/dbus/system_bus_socket, then finds no system
# bus: gnome-setup panicked at that point and stayed on "Installing Bootloader"
# after a complete install (run 45636360063).
RUN if [ -d /var/run ] && [ ! -L /var/run ]; then rm -rf /var/run; fi; \
    [ -L /var/run ] || ln -s ../run /var/run
# The live root overlay runs in the initrd (medium-live-root.service, the
# medium-sr0 module). The dracut files above change nothing until the
# initramfs is built again: the first real boots ran the initramfs of the
# cell image, with no overlay, and stopped in emergency mode on a read-only
# medium ("ostree-remount: failed to remount(rw) /etc: Permission denied",
# runs 45563432848 and 45568622066). Build each initramfs again and check
# that the unit is inside. An image with no dracut (a UKI image) has no
# initramfs.img to build; its live path is the live initrd of
# add-live-entry.sh, which also carries the loop attach of a CD boot
# (medium-sr0).
RUN set -eux; \
    if command -v dracut >/dev/null; then \
        found=0; \
        for img in /usr/lib/modules/*/initramfs.img; do \
            [ -f "${img}" ] || continue; \
            kver="$(basename "$(dirname "${img}")")"; \
            DRACUT_NO_XATTR=1 dracut --force --no-hostonly --tmpdir /tmp --kver "${kver}" "${img}"; \
            lsinitrd "${img}" >/tmp/medium-initrd.list; \
            grep -q 'medium-live-root.service' /tmp/medium-initrd.list; \
            grep -q 'systemd-volatile-root' /tmp/medium-initrd.list; \
            found=1; \
        done; \
        [ "${found}" = 1 ]; \
        rm -rf /tmp/* /var/tmp/* 2>/dev/null || true; \
    else \
        echo "live: no dracut in this image: no initramfs is rebuilt"; \
    fi
