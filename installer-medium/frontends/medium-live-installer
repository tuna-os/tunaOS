#!/usr/bin/bash
# Start an installer frontend in the live session (tunaOS#4905).
#
# Usage: medium-live-installer [--once] [--stamp APP_ID:WINDOW:SIGNAL] [--bus-name NAME] -- COMMAND [ARGS...]
#
# Installed as /usr/libexec/medium-live-installer by install-frontend.sh; every
# per-desktop autostart entry runs through it. It does nothing unless the
# kernel command line has tunaos.live, so an installed system that still
# carries the entry starts no installer. It sets TUNA_INSTALLER_BACKEND=daemon
# so the frontend talks to fishermand instead of the recipe pipeline.
#
# With --stamp the launcher writes $XDG_RUNTIME_DIR/tuna-installer-ready for a
# frontend that cannot (docs/INSTALLER-FRONTENDS.md, section 1). It waits up to
# 120 seconds for --bus-name to own a name on the session bus, then writes the
# stamp atomically. The claim is only as strong as SIGNAL says.
#
# With --once a second launcher in the same session starts nothing. A session
# with two start paths needs it: niri has the XDG autostart entry and a
# spawn-at-startup line. The lock is a file in $XDG_RUNTIME_DIR; the frontend
# holds it until it exits.
set -euo pipefail

stamp="" bus_name="" once=0
while [[ $# -gt 0 ]]; do
	case "$1" in
	--once)
		once=1
		shift
		;;
	--stamp)
		stamp="$2"
		shift 2
		;;
	--bus-name)
		bus_name="$2"
		shift 2
		;;
	--)
		shift
		break
		;;
	*)
		echo "medium-live-installer: unknown argument $1" >&2
		exit 2
		;;
	esac
done
[[ $# -gt 0 ]] || {
	echo "medium-live-installer: no command" >&2
	exit 2
}

cmdline="${MEDIUM_CMDLINE:-/proc/cmdline}"
grep -qw tunaos.live "${cmdline}" 2>/dev/null || {
	echo "medium-live-installer: not a tunaos.live boot; nothing to start" >&2
	exit 0
}

if ((once)); then
	exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/medium-live-installer.lock"
	flock -n 9 || {
		echo "medium-live-installer: the installer already runs in this session" >&2
		exit 0
	}
fi

export TUNA_INSTALLER_BACKEND=daemon

if [[ -n "${stamp}" ]]; then
	IFS=: read -r app_id window signal <<<"${stamp}"
	[[ -n "${app_id}" && -n "${window}" && -n "${signal}" ]] || {
		echo "medium-live-installer: --stamp wants APP_ID:WINDOW:SIGNAL" >&2
		exit 2
	}
	(
		for _ in $(seq 1 240); do
			if [[ -z "${bus_name}" ]] || busctl --user status "${bus_name}" >/dev/null 2>&1; then
				dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
				tmp="$(mktemp "${dir}/.tuna-installer-ready.XXXXXX")"
				printf 'app_id=%s\nwindow=%s\nsignal=%s\nmapped_at=%s\npage=unknown\n' \
					"${app_id}" "${window}" "${signal}" "$(date +%s.%3N)" >"${tmp}"
				mv -f "${tmp}" "${dir}/tuna-installer-ready"
				exit 0
			fi
			sleep 0.5
		done
		echo "medium-live-installer: ${bus_name} never appeared; no readiness stamp" >&2
	) &
fi
exec "$@"
