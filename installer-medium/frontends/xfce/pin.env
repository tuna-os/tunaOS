# Pinned frontend artifact for org.tunaos.InstallerXfce. Every value is immutable: an OCI manifest
# digest, a git commit or an ostree commit. A tag or branch here fails
# install.sh --check-pin and the bats pin test. Bump with the whole set.
#
# The image is the Flatpak OCI bundle that bootc-installer's publish-oci.yml
# pushes to ghcr.io/tuna-os/bootc-installer:<frontend>-<arch>. Digests below
# were resolved with skopeo on 2026-11-25.
APP_ID=org.tunaos.InstallerXfce
OCI_REPO=ghcr.io/tuna-os/bootc-installer
OCI_DIGEST_x86_64=sha256:f64327d6f26e841d378062c691b3b716a6e8479352a3a8eee9812c6dea912c63
OCI_DIGEST_aarch64=sha256:1f7f81ce127c7996b672972644ce56455ea05b7a6734d09a438703b00b5257e8
# The bootc-installer commit (branch dev) that the digests above were built
# from, in publish run 45665134118. It holds the daemon client, the stamp fix (#464) and
# the encryption default (#465). The x86_64 bundle was searched for the fix.
SOURCE_COMMIT=ee70bb518f91fe04d8f1cb551a2fc8634b0078c0
DAEMON_CLIENT_IN_DIGEST=yes
# Runtime from flathub, pinned to the ostree commit seen on 2026-11-25.
RUNTIME_REF=org.gnome.Platform//49
RUNTIME_COMMIT_x86_64=2bb946ea4ebb050f6a32f90e979feb975b08280d1ff1aac881dec3d1361ad84d
RUNTIME_COMMIT_aarch64=c3daeced6f88f9c4ffc4f88c798c48fffd395d873fc0d36b7fc73b753d7f59c9
