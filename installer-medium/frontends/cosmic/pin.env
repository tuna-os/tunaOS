# Pinned frontend artifact for org.tunaos.InstallerCosmic. Every value is immutable: an OCI manifest
# digest, a git commit or an ostree commit. A tag or branch here fails
# install.sh --check-pin and the bats pin test. Bump with the whole set.
#
# The image is the Flatpak OCI bundle that bootc-installer's publish-oci.yml
# pushes to ghcr.io/tuna-os/bootc-installer:<frontend>-<arch>. Digests below
# were resolved with skopeo on 2026-11-25.
APP_ID=org.tunaos.InstallerCosmic
OCI_REPO=ghcr.io/tuna-os/bootc-installer
OCI_DIGEST_x86_64=sha256:3d8a39f21b00b1d3f172fa1192dadfaa46bf4e6a78ce007be9627bdd50dca6ab
OCI_DIGEST_aarch64=sha256:4029027e256cb2dc2a03f3f961f9e9f70a2b4402b48e345e347d491417c7a51a
# The bootc-installer commit that holds the daemon client (#448-#451 merged
# into docs/shared-flow-spec, not dev). The digests above predate it.
SOURCE_COMMIT=f9d3b25078aaf64380e3d2319acc63fd5e0c3f61
DAEMON_CLIENT_IN_DIGEST=no
# Runtime from flathub, pinned to the ostree commit seen on 2026-11-25.
RUNTIME_REF=org.freedesktop.Platform//25.08
RUNTIME_COMMIT_x86_64=d7954c51f78a8b34e20a4d01942bd7b4881982cb5563371b3cec9c9b4134ebef
RUNTIME_COMMIT_aarch64=450c8dc4965eaeae9ee482eac9096e92ca3f3156e3db9d98b88ca86353ffb23a
