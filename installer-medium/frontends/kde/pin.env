# Pinned frontend artifact for org.tunaos.InstallerKde. Every value is immutable: an OCI manifest
# digest, a git commit or an ostree commit. A tag or branch here fails
# install.sh --check-pin and the bats pin test. Bump with the whole set.
#
# The image is the Flatpak OCI bundle that bootc-installer's publish-oci.yml
# pushes to ghcr.io/tuna-os/bootc-installer:<frontend>-<arch>. Digests below
# were resolved with skopeo on 2026-11-25.
APP_ID=org.tunaos.InstallerKde
OCI_REPO=ghcr.io/tuna-os/bootc-installer
OCI_DIGEST_x86_64=sha256:1f7f7a7db1818bece29ee68f6d0a0c553e67a53994a7782f253ae0466724f547
OCI_DIGEST_aarch64=sha256:76b62a766c75f41c649597036eed6f37101ba20b29e1aa5786697e717caa8447
# The bootc-installer commit (branch dev) that the digests above were built
# from, in publish run 45556492289. It holds the daemon client (#459, #461, #462).
# Both bundles were unpacked and searched for the client: see README.md.
SOURCE_COMMIT=25452dd3d942737da0383a1b8e81fb383726cebe
DAEMON_CLIENT_IN_DIGEST=yes
# Runtime from flathub, pinned to the ostree commit seen on 2026-11-25.
RUNTIME_REF=org.kde.Platform//6.11
RUNTIME_COMMIT_x86_64=2c059c881e5059ea801dc963cc970b83d775de03b98e9f570b31790e1f92ab5d
RUNTIME_COMMIT_aarch64=2466a2e0700664d03fbe6a105c7fc198bea32618787154f1f2262d23fa1c0284
