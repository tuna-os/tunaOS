From 92cf033a5481a94e3d31d68369d9aa461b474568 Mon Sep 17 00:00:00 2001
From: James Reilly <jreilly1821@gmail.com>
Date: Sat, 21 Nov 2026 20:50:26 +0000
Subject: [PATCH 1/8] main: Don't force demo mode and the debug overrides

main() set SETUP_DEMO and the SETUP_OVERRIDE_* variables unconditionally,
so a build installed on a distribution never talked to systemd-sysinstall
or systemd-cryptenroll and always ignored the session class and the
os-release release type. They remain available as environment variables
for development (SETUP_DEMO=true gnome-setup).

Signed-off-by: James Reilly <jreilly1821@gmail.com>
---
 src/main.rs | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/src/main.rs b/src/main.rs
index 7734411..cc5c725 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -18,13 +18,6 @@ use gettextrs::{bind_textdomain_codeset, bindtextdomain, textdomain};
 use config::{GETTEXT_PACKAGE, LOCALEDIR};
 
 fn main() -> glib::ExitCode {
-    // For debugging
-    // TODO: Try to come up with a better way to do this?
-    env::set_var("SETUP_OVERRIDE_IN_SESSION", "true");
-    env::set_var("SETUP_OVERRIDE_OS_RELEASE_TYPE", "stable");
-    env::set_var("SETUP_OVERRIDE_OS_EXPERIMENT", "");
-    env::set_var("SETUP_DEMO", "true");
-
     // Set up gettext translations
     bindtextdomain(GETTEXT_PACKAGE, LOCALEDIR).expect("Unable to bind the text domain");
     bind_textdomain_codeset(GETTEXT_PACKAGE, "UTF-8")
