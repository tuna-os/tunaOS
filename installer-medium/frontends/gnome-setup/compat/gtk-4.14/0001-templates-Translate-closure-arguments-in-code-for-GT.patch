From ce1988e7e0aab044b92dbcb84b2b9d2f6f31f309 Mon Sep 17 00:00:00 2001
From: TunaOS installer <installer@tunaos.invalid>
Date: Fri, 27 Nov 2026 04:04:25 +0000
Subject: [PATCH] templates: Translate closure arguments in code, for GTK
 before 4.16

Several templates pass translated strings into the $apply_osinfo,
$in_session and $release_type closures. blueprint-compiler emits those
as <constant translatable="yes">, which GtkBuilder accepts only from
GTK 4.16. On GTK 4.14 (Ubuntu 24.04) building the welcome page fails
with "attribute 'translatable' invalid for element 'constant'" and the
application aborts.

Pass the strings untranslated and translate them in apply_osinfo, which
the three closures call for every string argument. An empty string stays
empty. On GTK 4.16 and newer the result is the same. The msgids are
unchanged, so the existing translations apply.

Note for translators: the strings are no longer marked with _() in the
templates, so a regenerated .pot needs them marked another way (for
example an N_() list in osinfo.rs) before this goes upstream.

Signed-off-by: James Reilly <jreilly1821@gmail.com>
---
 src/osinfo.rs                               |  9 +++++++++
 src/page/done/done_page.blp                 |  4 ++--
 src/page/installer/install/install_page.blp |  4 ++--
 src/page/passphrase/page.blp                |  2 +-
 src/page/prerelease/page.blp                |  6 +++---
 src/page/welcome/page.blp                   | 10 +++++-----
 6 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/src/osinfo.rs b/src/osinfo.rs
index 16767e7..a413ccf 100644
--- a/src/osinfo.rs
+++ b/src/osinfo.rs
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-3.0-or-later */
 
 use formatx::formatx;
+use gettextrs::gettext;
 use glib::prelude::*;
 
 use std::env;
@@ -72,6 +73,14 @@ pub struct OsInfoCallbacks {}
 impl OsInfoCallbacks {
     #[template_callback]
     fn apply_osinfo(string: &str) -> String {
+        // The templates pass these strings untranslated: GtkBuilder before
+        // GTK 4.16 rejects a translatable <constant> in a closure. An empty
+        // string stays empty; gettext("") returns the catalog header.
+        let string = if string.is_empty() {
+            String::new()
+        } else {
+            gettext(string)
+        };
         let os_name = name();
         formatx!(string, os_name = os_name).unwrap()
     }
