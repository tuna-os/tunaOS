ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:5bd5a0a20767770309eb788038247cd536b5f4af94ff18c929729941537b493e
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
