ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:a027c0d159fdaeec22ab054269ff3af81b54bade277a188ea7318919bee30be9
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
