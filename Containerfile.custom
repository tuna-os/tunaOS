ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:f1fc4aec2031f8a547aa0b6024ce9baee66f66ae184bd2fedad4a773bce7cf81
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
