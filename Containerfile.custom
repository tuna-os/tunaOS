ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:e898b043dc5f2b46ddd147514306558508c4ec2f8b503a837252f5b5783a6619
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
