ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:6fc48d8f7e97785e2de9a84cc0ac11ad6f8242d7eea8b00055215a47642c301b
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
