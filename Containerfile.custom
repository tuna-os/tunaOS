ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:fdaa7b6eeb5d4edbc71c30fd4d23e499dd1af220ac2c6674f3543f94e0e154c1
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
