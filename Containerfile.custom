ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:2cc78b10db66d671218d19939770cbcf02551b892f6ab0e5bf3475368fe49708
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
