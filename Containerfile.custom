ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:aa085d440f93856a4971b4e4f38747e7d2a67532b01b8e03353e76474dc9b89c
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
