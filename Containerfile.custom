ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:88362929a5bb449c8848a89a7502b8b330092a9894f617952f9c4966aa328a26
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
