ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:723558dea3211eb2f113cff403d934dd06514e989d0ea748143b6e65cb0f3f58
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
