ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:a8d5650dad73ec947244f98f972df33192b37ee4bcd467209ffcfa2c37ee325a
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
