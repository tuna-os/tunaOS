ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:8e234618e29a79f0678fe977ce7743cb87d2841a5c2a30844614564730639713
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
