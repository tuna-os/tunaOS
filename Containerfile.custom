ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:bb4a3bfb1ad27faa451c1f6cb2c03c585cf8e0912d0c26e0bd9d8d6a6ce2f3e7
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
