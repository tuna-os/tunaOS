ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:51625f5613156f1ef38341cb1237972d819882d60074213a2767321c1927a257
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
