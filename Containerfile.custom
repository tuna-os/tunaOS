ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:ec25299007f227c0a9580ed3b72678adf7b17e63677c0c4b21a471f65281df99
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
