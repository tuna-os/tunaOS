ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:417797b8f037f33eb8d084cdcd2c6f691b578e757aa0d65701891e69789a5f8d
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
