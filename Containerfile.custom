ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:13b11aaec05c241227172e7639ef79fa7a7653dd7c1470669727a769967ed5ac
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
