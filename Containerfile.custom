ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:0dbb048b6b154b5446ad8b12caff8fe6319a2bbaf70380ac1881366adf633c3a
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
