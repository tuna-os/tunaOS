ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:654fe17965bb96638793d4c30d8be765eb948860f3aae75dfe79457b6661073b
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
