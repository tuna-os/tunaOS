# No default: `just build-custom` always passes the base (scripts/published-image-ref.sh
# resolves it from tunaos.toml), and a bare `podman build` should name one.
ARG BASE_IMAGE
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
