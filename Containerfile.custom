ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:fe39b12ced5091f87c93950fd048ccbfac526749c2e5fe1a0aa3f9533c251071
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
