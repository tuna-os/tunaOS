ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:5350cf6c7f898291066dbe9dd2f734ad2cd6ab4b6267d4152f9a3c073fffe332
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
