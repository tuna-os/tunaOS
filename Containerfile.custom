ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:de5f6dc1bbd1ad258cd7cc57af5d961ec1d0666a1928884ce16b54200c621cb2
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
