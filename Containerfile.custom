ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:831cfccb43cd781233552a6e8f37add64d11ec0dfed0f1794783f93a6a37024c
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
