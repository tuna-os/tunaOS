ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:5d11f8057f6ba4829f9e2dfccb46565f690969c3d20d76c13c058b3f653e018c
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
