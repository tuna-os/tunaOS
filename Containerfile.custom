ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:8f268fc8b27c8bf07bee80766d083530058799c6de66f8d6e66e9b635121725f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
