ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:4c72b2fd3060435f2dd13a441eb67d04f6a023a7aaff380a92ea27ee73fd216f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
