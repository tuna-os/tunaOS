ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:0ae5a5343c1d8e9446d088b65bedcecefd1e92198fe0655d4cfe1522032fb436
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
