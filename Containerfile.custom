ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:545863fee4eb27801d97cc3c22e7ca1b5e38670a521e225a34ff37e6cb8efe56
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
