ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:01fe991ecbf436719eba912e96ba5b6ae2febb528c4d0218bb611cb05cc420dc
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
