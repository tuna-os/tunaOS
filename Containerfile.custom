ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:668bfff637f63fdb251b2cd7f56b90f8787e8b3aea0b46df29aa3817f549b220
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
