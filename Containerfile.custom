ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:0a6c05f1129eebafd7f4c4a82fed3e9e0046763b8afc55b5a0e3ee9fc83e4108
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
