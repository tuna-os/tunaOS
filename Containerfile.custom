ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:4f8b750e92b020157bad25e4077c9ed4573a1ff6ba5c35674b9a79b1020f9c5e
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
