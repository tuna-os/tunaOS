ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:d4f4dc37009f9147a337330fb0e22115f0bd48d2577b7078aa62fca5ad271d21
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
