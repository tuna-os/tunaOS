ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:b6c7fb2cb1d51a2ce81a878682842fcb7947e141bce122adf8a7319e8df96c91
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
