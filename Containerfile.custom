ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:e6ca2b2ff6c9f7ce396d141c6e0800634a6adc8735b3d55b4069d68550337243
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
