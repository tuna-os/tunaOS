ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:316aa036cb9a3c01b9c55522eda32e2ad016653921d7b6766ae7020b2f7ff504
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
