ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:dd7d95c1331a9b28142b219a3939b6f4e11115e500fdc6ed5b65f974d53b2718
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
