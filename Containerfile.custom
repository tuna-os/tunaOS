ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:ebcbcb965c7fb560eeb8f8683974a949b89737c7f20072e3036b634a87971d5d
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
