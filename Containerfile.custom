ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:6abdce43c6987edc5fe454c9f3723b59701161f9d59a2d1870dd649297d7ea80
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
