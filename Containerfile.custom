ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:6a2d00c8299b65c88be360d39b22be9eb5b1221f8b25f560ce0de5fd0be6abbb
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
