ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:524669ad6a29779f929028129c6fb51d7fa81aae84f1f97021c0a84daf4d201c
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
