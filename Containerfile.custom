ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:6679cf3c9f4bce81fbbebe746b409fb30d836c30420e973effcd9e1238080976
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
