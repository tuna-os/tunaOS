ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:e379c9d344698c6a982fc20aa662da3b8bbdf73f4f32634a250e2085f18c1f52
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
