ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:1a0194071d93946b2414811fb3a30113eed4f8ba8ef901200083f964d349580a
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
