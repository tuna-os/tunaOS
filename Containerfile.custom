ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:a4bd6e5e662e37ccccfe1eb48166047c59597664574694b44872c88355f0b1fe
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
