ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:d5338133efd40a7c8b72ae658e46fbbedac750dbff458c959fa74b235439ca8a
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
