ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:8de0bdb8062fdb3b8aa5fc16eebc9796547420a9014c6d7f881d637f5ea570b8
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
