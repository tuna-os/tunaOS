ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:1f9823592a2dc958d6ba9d3d454b7c9df97508841fec52ae2823668c70af7dd2
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
