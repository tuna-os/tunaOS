ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:0a781d22e3f0ebfca3f433e4c6e337edf3df5aaccde542e4f2d8f56dfeff6b94
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
