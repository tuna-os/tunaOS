ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:40c8cbe5b5a3b855e142b7fc9b23e691cac096c03568a64668f0b28b0dd6b85f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
