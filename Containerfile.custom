ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:1e425c4ad18c9431f483fa812a2bd837204a160cb36919fbac87fa67df6bb00f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
