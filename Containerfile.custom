ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:6d8097b49fce8c997b3cc883288dc92388042df6709e47c5b78255273c89855e
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
