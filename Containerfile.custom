ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:fea8fd9d34f3d57c9285878fc9b9bbea6def1216e99d1f1dcdf9ac3168096c0f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
