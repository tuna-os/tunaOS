ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:420cb184f3ad20676db923ae4e83f85f1444baaaf79349497c519cf849fab6f9
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
