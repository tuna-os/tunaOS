ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:95ad13e34c57f45808017821a4919a24b70294bc44b47037b06ddbd816031fff
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
