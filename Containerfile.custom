ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:570567d02104c3af2782ac88fd0c421eb85accfb1baf8d1e1a6cdef3e52b11ba
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
