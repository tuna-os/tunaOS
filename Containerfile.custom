ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:be9799339adc572ca18d637f1505214a422c1f7457a09809885d717ca1ac177f
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
