ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:7a0cb2f0f952c78c11b8c32579828735d124b88784dfaccc8ee721aa6c86559c
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
