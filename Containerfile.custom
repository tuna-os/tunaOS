ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:96e3bed032eb3cf16d689fcc900bb403fa67f448c7d4a23fef903122df423ccd
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
