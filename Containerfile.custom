ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:4019942b1790fc520ca0777a766e63fd5c72eca5e7e38142511653fe1af5e978
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
