ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:66c9e61b520ec1e7bacb57d66992763816d1ed8be70b5d0adb52f16660a8b594
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
