ARG BASE_IMAGE=ghcr.io/tuna-os/yellowfin:gnome@sha256:ebc691a95677c1db5e2c01df3ee47843adc5793b6a476b8ed8b8d3b6402554e4
FROM scratch AS ctx
COPY custom /custom
COPY build_scripts /build_scripts

FROM ${BASE_IMAGE}
RUN --mount=type=bind,from=ctx,src=/,target=/run/context \
    /run/context/build_scripts/apply-custom.sh
RUN bootc container lint
